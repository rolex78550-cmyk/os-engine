ADMIN_EMAIL=
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PRODUCT_ID_MONTHLY=
DODO_PRODUCT_ID_YEARLY=
DODO_PRODUCT_ID_LIFETIME=
DODO_PAYMENTS_MODE=
FIREBASE_PROJECT_ID=
GEMINI_API_KEY=
NOTIFICATION_FROM_EMAIL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
VITE_DODO_PAYMENTS_MODE=
VITE_RAZORPAY_KEY_ID=
# Optional Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX) for country-wise GSC + conversion funnel tracking
VITE_GA_MEASUREMENT_ID=
# Secret used by the XP season-rollover cron (/api/xp/season-rollover).
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Firebase Admin SDK (REQUIRED on Vercel — server writes XP / task claims / season rollover)
# Firebase console → Project settings → Service accounts → "Generate new private key"
# Paste the whole JSON on one line (or base64 of it). Alternative: FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY
FIREBASE_SERVICE_ACCOUNT=

# Server-side daily reminder system (never prefix private keys with VITE_)
# Generate keys once: npx web-push generate-vapid-keys --json
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@menifestos.com
# Resend verified domain sender required for real user email delivery
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=Menifest OS <reminders@menifestos.com>
# Random strong secret shared with your external recurring scheduler
CRON_SECRET=
REMINDER_ORIGIN=https://www.menifestos.com
