# Secret used by the XP season-rollover cron (/api/xp/season-rollover).
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Firebase Admin SDK (REQUIRED on Vercel — server writes XP / task claims / season rollover)
# Firebase console → Project settings → Service accounts → "Generate new private key"
# Paste the whole JSON on one line (or base64 of it). Alternative: FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY
FIREBASE_SERVICE_ACCOUNT=
